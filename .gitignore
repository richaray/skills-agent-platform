# Secrets - never commit these
.env
*.env
!.env.example

# Scratch files people keep credentials in. Belt and braces: the real rule is
# "keep credentials outside the repo folder", but these patterns mean a stray
# `git add -A` cannot pick them up by accident.
keys
keys.*
secrets
secrets.*
credentials
credentials.*
*.key
*.pem
token.txt
notes-private.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Local database file (we use SQLite locally, Postgres in production)
*.db
*.sqlite3

# Frontend
node_modules/
frontend/dist/
app/static/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
