# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- LLM provider ---
# Get a free key at https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# --- Database ---
# Leave as-is for local development (creates a local file called local.db).
# In production, set this to your Neon Postgres connection string, e.g.
# postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///./local.db

# --- App ---
LOG_LEVEL=INFO
