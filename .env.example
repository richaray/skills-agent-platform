# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- LLM provider ---
# Get a free key at https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=your-gemini-api-key-here

# The model tried first. Must support function calling.
# Google's free tier limits requests PER DAY PER MODEL, so a lite model with a
# larger allowance is a better default than a frontier model.
GEMINI_MODEL=gemini-3.1-flash-lite

# Tried in order when the model above is out of quota or has been retired.
# Because quota is counted per model, this multiplies the daily budget.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.6-flash,gemini-3-flash-preview,gemini-flash-latest

# --- Database ---
# Leave as-is for local development (creates a local file called local.db).
# In production, set this to your Neon Postgres connection string, e.g.
# postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///./local.db

# --- App ---
LOG_LEVEL=INFO
